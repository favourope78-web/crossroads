    - id: "dec_sera_lookout"
      promptText: "Sera watches the hall. What do you say?"
      timeLimitSeconds: 0
      timeoutOptionIndex: 0
      codexEntryId: ""
      options:
      - id: "lookout"
        text: "I'd feel better with an eye on that north seal."
        afterText: "Sera nods once and takes up a spot by the north wall, eyes on the seal."
        conditions:
        - type: 0
          key: "c1_hall_drive"
          value: "tide"
          amount: 0
