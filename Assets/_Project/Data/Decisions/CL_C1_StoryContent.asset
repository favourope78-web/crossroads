    - id: "g_i2_archivist"
      nodes:
      - id: "n0"
        speaker: "The Archivist"
        text: "Ari. Twenty years old, four since the Fracture. I have kept the count: your echoes, your codex, your debts."
        nextId: "n1"
        branchPrefix: ""
        decisionId: ""
        conditions: []
        end: 0
      - id: "n1"
        speaker: ""
        text: ""
        nextId: ""
        branchPrefix: "recap"
        decisionId: ""
        conditions: []
        end: 0
      - id: "recap_v0"
        speaker: "The Archivist"
        text: "Kael taught you to hit first. Your Ember runs hot; the Choir marks you as a threat, not a harvest."
        nextId: "n2"
        branchPrefix: ""
        decisionId: ""
        conditions:
        - type: 6
          key: "dec_mentor"
          value: "kael"
          amount: 0
        end: 0
      - id: "recap_v1"
        speaker: "The Archivist"
        text: "Odalys taught you to breathe first. Your Tide runs deep; the relief lines say your name like a prayer."
        nextId: "n2"
        branchPrefix: ""
        decisionId: ""
        conditions:
        - type: 6
          key: "dec_mentor"
          value: "odalys"
          amount: 0
        end: 0
      - id: "recap_v2"
        speaker: "The Archivist"
        text: "Bran taught you to stand first. Your Stone runs steady; the Wardens count you as one of their own."
        nextId: "n2"
        branchPrefix: ""
        decisionId: ""
        conditions:
        - type: 6
          key: "dec_mentor"
          value: "bran"
          amount: 0
        end: 0
      - id: "recap"
        speaker: ""
        text: ""
        nextId: "n2"
        branchPrefix: ""
        decisionId: ""
        conditions: []
        end: 0
      - id: "n2"
        speaker: "The Archivist"
        text: "The Choir holds three places in Vessa. You may take back one. Choose the shape of your becoming."
        nextId: "decide"
        branchPrefix: ""
        decisionId: ""
        conditions: []
        end: 0
      - id: "decide"
        speaker: ""
        text: ""
