          value: "odalys"
          amount: 0
        end: 0
      - id: "epmentor_v2"
        speaker: "The Archivist"
        text: "Warden Bran: Fallen. He held a door for six hours once. On the Spire he held one for you."
        nextId: "n4"
        branchPrefix: ""
