    - id: "g_c2_mentor_interlude"
      nodes:
      - id: "n0"
        speaker: ""
        text: ""
        nextId: ""
        branchPrefix: "c2m"
        decisionId: ""
        conditions: []
        end: 0
      - id: "c2m_v0"
        speaker: "Kael"
        text: "You listened under the Spire. Keep listening: the Docks fall to whoever is willing to burn the pier. Are you?"
        nextId: "end"
        branchPrefix: ""
        decisionId: ""
        conditions:
        - type: 0
          key: "mentor_obeyed"
          value: "1"
          amount: 0
        - type: 6
          key: "dec_mentor"
          value: "kael"
          amount: 0
        end: 0
      - id: "c2m_v1"
        speaker: "Kael"
        text: "You didn't listen under the Spire. It worked. It won't always. The Docks are yours if you want them - my advice, or not."
        nextId: "end"
        branchPrefix: ""
        decisionId: ""
        conditions:
        - type: 6
          key: "dec_mentor"
          value: "kael"
          amount: 0
        end: 0
      - id: "c2m_v2"
        speaker: "Sister Odalys"
        text: "You listened under the Spire. The Sanctuary holds the last clean water in the Reaches. If it falls, so do the relief lines."
        nextId: "end"
        branchPrefix: ""
        decisionId: ""
        conditions:
        - type: 0
          key: "mentor_obeyed"
          value: "1"
          amount: 0
        - type: 6
          key: "dec_mentor"
          value: "odalys"
          amount: 0
        end: 0
      - id: "c2m_v3"
        speaker: "Sister Odalys"
        text: "You went your own way under the Spire - and you're alive. Good. The Sanctuary needs someone who knows when not to listen."
        nextId: "end"
        branchPrefix: ""
        decisionId: ""
        conditions:
        - type: 6
          key: "dec_mentor"
          value: "odalys"
          amount: 0
        end: 0
      - id: "c2m_v4"
        speaker: "Warden Bran"
        text: "You held under the Spire like I told you. The Long Wall is longer than any of us. Hold it anyway."
        nextId: "end"
        branchPrefix: ""
        decisionId: ""
        conditions:
        - type: 0
          key: "mentor_obeyed"
          value: "1"
          amount: 0
        - type: 6
          key: "dec_mentor"
          value: "bran"
          amount: 0
        end: 0
      - id: "c2m_v5"
        speaker: "Warden Bran"
        text: "You didn't hold the way I said. You held your way. The Wall doesn't care whose way - only that it's held."
        nextId: "end"
        branchPrefix: ""
        decisionId: ""
        conditions:
        - type: 6
          key: "dec_mentor"
          value: "bran"
