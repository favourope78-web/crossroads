          amount: 0
        - type: 7
          key: "spire"
          value: "collapsed"
          amount: 0
      - id: "balance"
        text: "Hold the heart open. Let the light stay - shared, watched, never owned. Mara and Dax will help you watch it."
        afterText: "Nothing ends. That was the point. Ending: BALANCE."
        conditions:
        - type: 2
