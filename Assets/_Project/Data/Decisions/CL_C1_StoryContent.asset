          value: "healed"
          amount: 0
      - id: "the_unmoved"
        text: "Seal the heart under stone. Nothing gets in; nothing gets out; the city stands."
        afterText: "The Fracture closes under a weight only you could set. The districts you saved stand on it. Ending: THE UNMOVED."
        conditions:
        - type: 2
          key: "cm_refused"
