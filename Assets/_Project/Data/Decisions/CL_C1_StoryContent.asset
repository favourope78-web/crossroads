        nextId: "end"
        branchPrefix: ""
        decisionId: ""
        conditions:
        - type: 6
          key: "dec_c2_path"
          value: "docks"
          amount: 0
        end: 0
      - id: "after_sanctuary"
        speaker: "The Archivist"
        text: "The Sanctuary. A defence. Hold what the Choir wants to drown."
        nextId: "end"
        branchPrefix: ""
        decisionId: ""
        conditions:
        - type: 6
          key: "dec_c2_path"
          value: "sanctuary"
          amount: 0
        end: 0
