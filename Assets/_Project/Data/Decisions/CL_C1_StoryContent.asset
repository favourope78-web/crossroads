          name: "Dax Confrontation"
        - id: "interlude_reckoning"
          name: "Interlude: Reckoning"
        - id: "market"
          name: "The Old Market"
        - id: "spire_ascent"
          name: "Ascent of the Spire"
        - id: "choirmaster"
          name: "The Choirmaster"
