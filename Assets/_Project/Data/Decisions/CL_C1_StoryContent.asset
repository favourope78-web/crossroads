          amount: 2
        - type: 9
          key: "c1_archivist_hint"
          value: ""
          amount: 0
      - id: "keep_low"
        text: "Keep your head down, Sera."
        afterText: "Sera melts back into the shadows. You almost lose her."
        conditions: []
        effects:
        - type: 4
          key: "sera"
