        - type: 17
          key: "obj_tide_report"
          value: ""
          amount: 0
        title: "Mara · Heartened"
        moodLine: "Mara stands easier since you told her how it felt."
        approachDistance: 1.2
        avoidDistance: -1.0
        moveSpeed: -1.0
        reactRadius: -1.0
      - conditions:
        - type: 5
          key: "mara"
          value: ""
          amount: 8
        title: "Mara · Warm"
        moodLine: "Mara's eyes soften. She stays closer now."
        approachDistance: 1.3
        avoidDistance: -1
        moveSpeed: -1
