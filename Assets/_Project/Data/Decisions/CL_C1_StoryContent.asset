    - id: "g_c3_cm_open"
      nodes:
      - id: "n0"
        speaker: "The Choirmaster"
        text: "Ari. First-lit. I have sung your name for ten years; you have finally come to hear it."
        nextId: "n1"
        branchPrefix: ""
        decisionId: ""
        conditions: []
        end: 0
      - id: "n1"
        speaker: "The Choirmaster"
        text: "Everything the Fracture gave, I will gather. Every echo. Yours last."
        nextId: "end"
        branchPrefix: ""
