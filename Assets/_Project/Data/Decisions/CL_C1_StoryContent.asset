        requiredBeatIds: []
        onResolveEffects: []
        priority: 0
      - id: "beat_sera_echo"
        title: "Tell Sera what the light left"
        journalText: "You told Sera what the light left in you. She did not flinch."
        offerConditions:
          - type: 6
