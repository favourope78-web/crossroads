    locations:
    - id: "hall"
      name: "Fracture Hall"
      kind: 0
      sceneKey: "FirstLocation"
      checkpointId: "hall_spawn"
      description: "The great central hall where the Trode asks its question. Story trunk, camp, the way to everywhere else."
      unlockRules: []
      lockedHint: ""
      entryConditions: []
      connections:
