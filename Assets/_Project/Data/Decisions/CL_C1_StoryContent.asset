          key: "c1_sera_lookout"
          value: ""
          amount: 0
      - id: "shard_show"
        text: "Show her what you found in the annex."
        afterText: "Sera traces its edge. 'They'll want this. Keep it hidden, and keep moving.'"
        conditions:
        - type: 10
