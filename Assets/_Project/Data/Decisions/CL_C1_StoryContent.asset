        - type: 7
          key: "vessa"
          value: "ashen"
          amount: 0
      - id: "tides_embrace"
        text: "Pour the heart into the city's water. Heal what the light broke - with Mara beside you."
        afterText: "The Fracture goes into the sea like a tide going out. Mara's hand is in yours the whole time. Ending: TIDE'S EMBRACE."
        conditions:
        - type: 2
          key: "cm_refused"
          value: ""
          amount: 0
        - type: 0
