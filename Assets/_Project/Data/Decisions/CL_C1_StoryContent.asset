    - id: "dec_tide_report"
      promptText: "Mara waits by the east columns. What do you tell her about the twins?"
      timeLimitSeconds: 0.0
      timeoutOptionIndex: 0
      codexEntryId: "c1_tide_report"
      options:
      - id: "tell_all"
        text: "Everything. The rush, the light, the small hand in yours."
        afterText: "Mara listens to all of it, and something in her shoulders lets go."
        conditions: []
        effects:
        - type: 0
          key: "tide_reported"
          value: "1"
          amount: 0
        - type: 4
          key: "mara"
          value: ""
          amount: 5
        - type: 2
          key: "tide"
          value: ""
          amount: 5
      - id: "keep_light"
        text: "That it went fine. Some things should stay theirs."
        afterText: "Mara nods once, letting it be - but she catches your sleeve before you go."
        conditions: []
        effects:
        - type: 0
          key: "tide_reported"
          value: "1"
          amount: 0
        - type: 4
          key: "mara"
          value: ""
          amount: 2
    - id: "camp_sera_echo_dec"
      promptText: "Sera saw which way the light took you. What do you tell her?"
      timeLimitSeconds: 0.0
      timeoutOptionIndex: 0
      codexEntryId: "c1_sera_echo"
      options:
      - id: "tell_her"
        text: "Tell her the truth of it."
        afterText: "Sera nods once, slow. 'Then we hold the line together.'"
        conditions: []
        effects:
        - type: 0
          key: "sera_echo_seen"
          value: "1"
          amount: 0
        - type: 4
          key: "sera"
          value: ""
          amount: 2
      - id: "deflect"
        text: "Keep it behind your teeth."
        afterText: "'Fair,' Sera says. 'Keep it that way until it's ready.'"
        conditions: []
        effects:
        - type: 0
          key: "sera_echo_seen"
          value: "1"
          amount: 0
    - id: "dec_kite"
      promptText: "Mara's paper kite snags on the pier rail and the string breaks in your hand. She is looking at you."
      timeLimitSeconds: 0
      timeoutOptionIndex: 0
      codexEntryId: "p1_last_summer"
      options:
      - id: "give"
        text: "Knot the string and hand it back. It was always hers."
        afterText: "Mara ties the string twice round her wrist so it can't happen again."
        conditions: []
        effects:
        - type: 4
          key: "mara"
          value: ""
          amount: 12
        - type: 2
          key: "tide"
          value: ""
          amount: 5
        - type: 9
          key: "p1_kite_given"
          value: ""
          amount: 0
        - type: 15
          key: "paper_kite"
          value: ""
          amount: 0
        - type: 0
          key: "tut_kite"
          value: "1"
          amount: 0
      - id: "keep"
        text: "Keep it. You'll fix it properly at home."
        afterText: "Mara shrugs like it doesn't matter. It does."
        conditions: []
        effects:
        - type: 4
          key: "mara"
          value: ""
          amount: 2
        - type: 2
          key: "stone"
          value: ""
          amount: 5
        - type: 15
          key: "paper_kite"
          value: ""
          amount: 0
        - type: 0
          key: "tut_kite"
          value: "1"
          amount: 0
      - id: "fly"
        text: "Throw it back into the wind, broken string and all."
        afterText: "It flies - badly, gloriously - and Mara laughs so hard she sits down."
        conditions: []
        effects:
        - type: 4
          key: "mara"
          value: ""
          amount: 7
        - type: 2
          key: "ember"
          value: ""
          amount: 5
        - type: 15
          key: "paper_kite"
          value: ""
          amount: 0
        - type: 0
          key: "tut_kite"
          value: "1"
          amount: 0
    - id: "dec_pier"
      promptText: "Dax and the older kids are daring each other off the end of the pier. Mara wants to go home. Dax is watching you."
      timeLimitSeconds: 0
      timeoutOptionIndex: 0
      codexEntryId: "p1_pier"
      options:
      - id: "stay"
        text: "Stay with Mara. Walk her home."
        afterText: "Dax shouts something after you. Mara pretends not to hear it, and so do you."
        conditions: []
        effects:
        - type: 4
          key: "mara"
          value: ""
          amount: 10
        - type: 4
          key: "dax"
          value: ""
          amount: -4
        - type: 2
