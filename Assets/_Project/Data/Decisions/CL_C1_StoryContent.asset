          amount: 0
        - type: 7
          key: "vessa"
          value: "balanced"
          amount: 0
      - id: "martyrs_dawn"
        text: "Put yourself into the heart. Close it from the inside."
        afterText: "It takes everything you are - which, by now, is a great deal. The dawn over Vessa is the first clean one in ten years. Ending: MARTYR'S DAWN."
        conditions:
