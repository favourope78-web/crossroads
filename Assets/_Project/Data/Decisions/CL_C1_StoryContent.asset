    - id: "g_c3_cm_transition"
      nodes:
      - id: "n0"
        speaker: ""
        text: "The overture breaks. In the silence you can hear the sea."
        nextId: "n1"
        branchPrefix: ""
        decisionId: ""
        conditions: []
        end: 0
      - id: "n1"
        speaker: ""
        text: ""
        nextId: ""
        branchPrefix: "cmt"
        decisionId: ""
        conditions: []
        end: 0
      - id: "cmt_v0"
        speaker: "Kael"
        text: "Kid. Say the word and I'll hold it. You hit first - like I taught you."
        nextId: "decide"
        branchPrefix: ""
        decisionId: ""
        conditions:
        - type: 0
          key: "mentor_fate"
          value: "alive"
          amount: 0
        - type: 6
          key: "dec_mentor"
          value: "kael"
          amount: 0
        end: 0
      - id: "cmt_v1"
        speaker: "Sister Odalys"
        text: "Breathe. If you need me to stand in front - I have stood in front before."
        nextId: "decide"
        branchPrefix: ""
        decisionId: ""
        conditions:
        - type: 0
          key: "mentor_fate"
          value: "alive"
          amount: 0
        - type: 6
          key: "dec_mentor"
          value: "odalys"
          amount: 0
        end: 0
      - id: "cmt_v2"
        speaker: "Warden Bran"
        text: "I'll hold it. That's what I'm for. Your call."
        nextId: "decide"
        branchPrefix: ""
        decisionId: ""
        conditions:
        - type: 0
          key: "mentor_fate"
          value: "alive"
          amount: 0
        - type: 6
          key: "dec_mentor"
          value: "bran"
          amount: 0
        end: 0
