          amount: 0
        end: 0
      - id: "epmentor_v1"
        speaker: "The Archivist"
        text: "Sister Odalys: Fallen. The Sanctuary keeps a wet hem in a glass case, and the relief lines sing her name."
        nextId: "n4"
        branchPrefix: ""
        decisionId: ""
        conditions:
        - type: 0
