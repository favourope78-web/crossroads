    - id: "annex"
      name: "North Annex"
      kind: 3
      sceneKey: "FirstLocation"
      checkpointId: "annex_spawn"
      description: "Beyond the energy seal: the choir beacon, the Warden the Choir sent for it, and a cache that only answers ember."
      unlockRules:
      - conditions:
          - type: 11
            key: "ember_pulse"
            value: ""
            amount: 0
        opens: 1
        text: "The seal drinks the echo and parts. The North Annex lies open."
      - conditions:
          - type: 11
            key: "tide_mend"
            value: ""
            amount: 0
        opens: 1
        text: "The seal softens like water around your hand. The North Annex lies open."
      - conditions:
          - type: 11
            key: "stone_ward"
            value: ""
            amount: 0
        opens: 1
        text: "The seal holds, then yields - unhurried, the way you asked it. The North Annex lies open."
      lockedHint: "A seal of the hall's own light. It only parts for an echoed voice."
      entryConditions: []
      connections:
      - "hall"
      npcs: []
      encounters:
      - "c1_hall_shard"
      - "c1_east_shrine"
