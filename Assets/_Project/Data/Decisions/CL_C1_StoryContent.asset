        nextId: "sera_offer"
        branchPrefix: ""
        decisionId: ""
        conditions:
        - type: 0
          key: "c1_hall_drive"
          value: "tide"
          amount: 0
        end: 0
      - id: "sera_line_stone"
        speaker: "Sera"
        text: "You went still as the wall and the sweep passed right through. I don't know if that's luck - or something else."
        nextId: "sera_offer"
        branchPrefix: ""
        decisionId: ""
        conditions:
        - type: 0
          key: "c1_hall_drive"
          value: "stone"
          amount: 0
        end: 0
