        vfxRef: "fx/hollow/throne"
        sfxRef: "sfx/hollow/throne"
        echoCostPerLevel: 10
        levels:
        - level: 1
          cooldown: 12.0
          power: 1.0
          radius: 3.5
          duration: 1.0
          energyCost: 0
          description: "The weak fall at once."
        - level: 2
          cooldown: 9.0
          power: 1.5
          radius: 4.5
          duration: 1.4
          energyCost: 0
          description: "The threshold rises; more of them are weak."
        - level: 3
          cooldown: 6.0
          power: 2.25
          radius: 6.0
          duration: 1.8
          energyCost: 0
          description: "Full bind. The throne is wherever you stand."
      skills:
        - id: "echo_attunement"
          name: "Echo Attunement"
          maxLevel: 3
      items:
        - id: "echo_shard"
          name: "Fracture Shard"
          description: "A cold-warm sliver of the Fracture light. It held still for you."
        - id: "twins_keepsake"
          name: "Twins' Keepsake"
          description: "A stamped tin locket, warm from being held too tight. It belongs to the twins by the east columns."
        - id: "ember_core"
          name: "Ember Core"
          description: "What the beacon guarded before it forgot your name. It hums with banked heat."
        - id: "paper_kite"
          name: "Mara's Paper Kite"
          description: "A kite the colour of the last summer. The string is knotted where it broke and was mended."
        - id: "mentor_token"
          name: "Mentor's Token"
          description: "A small pressed sigil in your mentor's line colour. It is warm when they are near."
        - id: "dax_echo"
          name: "Dax's Echo"
          description: "What was left of a rival's light, folded into yours. It does not sit quietly."
        - id: "cantor_voice"
          name: "The Cantor's Voice"
          description: "A shard of the Choir's song, cut loose. It remembers every name it took."
      reputationGroups:
        - id: "choir"
          name: "The Choir"
        - id: "folk"
          name: "People of Vessa"
        - id: "wards"
          name: "The Wardens"
