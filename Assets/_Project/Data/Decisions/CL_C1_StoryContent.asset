        speaker: ""
        text: ""
        nextId: ""
        branchPrefix: "docks"
        decisionId: ""
        conditions: []
        end: 0
      - id: "docks_v0"
        speaker: "The Archivist"
        text: "The Docks are a flooded sanctum now; the relief lines row between the cranes."
        nextId: "n3"
        branchPrefix: ""
        decisionId: ""
        conditions:
        - type: 19
          key: "docks"
          value: "flooded"
          amount: 0
        end: 0
      - id: "docks_v1"
        speaker: "The Archivist"
        text: "The Docks are a fortified wall; the Wardens hold them the way you held the Long Wall."
        nextId: "n3"
        branchPrefix: ""
        decisionId: ""
        conditions:
        - type: 19
          key: "docks"
          value: "fortified"
          amount: 0
        end: 0
      - id: "docks_v2"
        speaker: "The Archivist"
        text: "The Docks work again - cranes lifting, hulls scraped clean of the Choir's marks."
        nextId: "n3"
        branchPrefix: ""
        decisionId: ""
        conditions:
        - type: 19
