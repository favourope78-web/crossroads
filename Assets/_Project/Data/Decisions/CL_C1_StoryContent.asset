      - id: "start"
        speaker: ""
        text: ""
        nextId: ""
        branchPrefix: "confide_line"
        decisionId: ""
        conditions: []
        end: 0
      - id: "confide_line_quiet"
        speaker: "Mara"
        text: "The north went quiet an hour ago - the whole hall felt it exhale. Whatever you did up there, it stays done."
        nextId: "confide_promise"
        branchPrefix: ""
        decisionId: ""
        conditions:
        - type: 0
