    - id: "dec_ending"
      promptText: "The Fracture's heart is open and quiet. What you do with it now is the last thing this life decides."
      timeLimitSeconds: 0
      timeoutOptionIndex: 0
      codexEntryId: "c3_final_decision"
      options:
      - id: "ashen_crown"
        text: "Burn the heart out. Let the Choir end in fire - and every rival with it."
        afterText: "The Fracture burns from the inside. Vessa will be safe, and it will be afraid of you. Ending: ASHEN CROWN."
        conditions:
        - type: 2
          key: "cm_refused"
