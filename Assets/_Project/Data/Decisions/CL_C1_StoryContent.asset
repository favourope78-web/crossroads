          amount: 0
      - id: "long_way_home"
        text: "Leave it. Walk down the Spire and go home."
        afterText: "You walk down. Whatever Vessa becomes, it becomes without you standing on the light. Ending: THE LONG WAY HOME."
        conditions: []
