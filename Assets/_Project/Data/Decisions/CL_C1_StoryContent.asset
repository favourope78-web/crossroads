      name: "Tidewell Shrine"
      kind: 2
      sceneKey: "FirstLocation"
      checkpointId: "tidewell_spawn"
      description: "A drowned shrine east of the hall. Sera keeps its lamp now, and the water remembers what you carried out of it."
