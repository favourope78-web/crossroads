    progression:
      abilities:
      - id: "ember_pulse"
        name: "Ember Pulse"
        line: "ember"
        description: "The first echo. Heat answers your will in a red pulse that rolls through water and air alike. (Gates: hall energy seals.)"
        category: 0
        unlockHint: "Claim the Fracture light in the First Hall."
        unlockConditions:
          - type: 6
            key: "dec_c1_hall_first_light"
            value: "ember_reach"
            amount: 0
        vfxRef: "fx/pulse/ember"
        sfxRef: "sfx/pulse/ember"
        echoCostPerLevel: 10
        levels:
        - level: 1
          cooldown: 12.0
          power: 1.0
          radius: 3.5
          duration: 1.0
          energyCost: 0
          description: "A restrained burst. The echo answers once, then waits."
        - level: 2
          cooldown: 9.0
          power: 1.5
          radius: 4.5
          duration: 1.4
          energyCost: 0
          description: "The pulse runs deeper and returns sooner. The hall's heat bends around you."
        - level: 3
          cooldown: 6.0
          power: 2.25
          radius: 6.0
          duration: 1.8
          energyCost: 0
          description: "Full bind. The echo answers as fast as your heart and burns twice as wide."
      - id: "tide_mend"
        name: "Tide Mend"
        line: "tide"
        description: "The first echo. A cool washing swell that soothes what the Fracture has bruised - and settles those who stand too close. (Gates: hall energy seals.)"
        category: 0
        unlockHint: "Put others first when the light falls in the First Hall."
        unlockConditions:
          - type: 6
            key: "dec_c1_hall_first_light"
            value: "tide_clear"
            amount: 0
        vfxRef: "fx/pulse/tide"
        sfxRef: "sfx/pulse/tide"
        echoCostPerLevel: 10
        levels:
        - level: 1
          cooldown: 12.0
          power: 1.0
          radius: 3.5
          duration: 1.0
          energyCost: 0
          description: "A soft wash. Frayed edges pull themselves straight."
        - level: 2
          cooldown: 9.0
          power: 1.5
          radius: 4.5
          duration: 1.4
          energyCost: 0
          description: "The wash carries further and comes sooner. The hall breathes easier around you."
        - level: 3
          cooldown: 6.0
          power: 2.25
          radius: 6.0
          duration: 1.8
          energyCost: 0
          description: "Full bind. The tide moves through you like it has always known the way."
      - id: "stone_ward"
        name: "Stone Ward"
        line: "stone"
        description: "The first echo. A ring of stillness that slows what moves too fast and holds what moves too close. (Gates: hall energy seals.)"
        category: 0
        unlockHint: "Refuse to move when the light hunts in the First Hall."
        unlockConditions:
          - type: 6
            key: "dec_c1_hall_first_light"
            value: "stone_still"
            amount: 0
        vfxRef: "fx/pulse/stone"
        sfxRef: "sfx/pulse/stone"
        echoCostPerLevel: 10
        levels:
        - level: 1
          cooldown: 12.0
          power: 1.0
          radius: 3.5
          duration: 1.0
          energyCost: 0
          description: "A quiet ring. The hurry around you remembers how to wait."
        - level: 2
          cooldown: 9.0
          power: 1.5
          radius: 4.5
          duration: 1.4
          energyCost: 0
          description: "The ring holds wider and re-forms sooner. Stillness bends around you."
        - level: 3
          cooldown: 6.0
          power: 2.25
          radius: 6.0
          duration: 1.8
          energyCost: 0
          description: "Full bind. You are where you stand - and the hall knows it."
      - id: "cinder_burst"
        name: "Cinder Burst"
        line: "ember"
        description: "Kael's lesson: heat thrown outward in a ring that knocks the Choir off their song."
        category: 0
        unlockHint: "Choose Kael as your mentor on the night of the Fracture."
        unlockConditions:
          - type: 6
            key: "dec_mentor"
            value: "kael"
            amount: 0
        vfxRef: "fx/burst/cinder"
        sfxRef: "sfx/burst/cinder"
        echoCostPerLevel: 10
        levels:
        - level: 1
          cooldown: 12.0
          power: 1.0
          radius: 3.5
          duration: 1.0
          energyCost: 0
          description: "A tight ring of cinders. Close things burn."
        - level: 2
          cooldown: 9.0
          power: 1.5
          radius: 4.5
          duration: 1.4
          energyCost: 0
          description: "The ring widens; the burn lingers."
        - level: 3
          cooldown: 6.0
          power: 2.25
          radius: 6.0
          duration: 1.8
          energyCost: 0
          description: "Full bind. The air itself catches."
      - id: "phoenix_reckoning"
        name: "Phoenix Reckoning"
        line: "ember"
        description: "The Ember capstone: every strike detonates for a breath of borrowed fire."
        category: 0
        unlockHint: "Take the Contested Docks by force."
        unlockConditions:
          - type: 17
            key: "obj_docks_assault"
            value: ""
            amount: 0
        vfxRef: "fx/ult/phoenix"
        sfxRef: "sfx/ult/phoenix"
        echoCostPerLevel: 10
        levels:
        - level: 1
          cooldown: 12.0
          power: 1.0
          radius: 3.5
          duration: 1.0
          energyCost: 0
          description: "Eight seconds of burning strikes."
        - level: 2
          cooldown: 9.0
          power: 1.5
          radius: 4.5
          duration: 1.4
          energyCost: 0
          description: "The fire returns sooner and reaches further."
        - level: 3
          cooldown: 6.0
          power: 2.25
          radius: 6.0
          duration: 1.8
          energyCost: 0
          description: "Full bind. You are the beacon now."
      - id: "riptide"
        name: "Riptide"
        line: "tide"
        description: "Odalys's lesson: a cone of water that drags what would flee into reach."
        category: 0
        unlockHint: "Choose Sister Odalys as your mentor on the night of the Fracture."
        unlockConditions:
          - type: 6
            key: "dec_mentor"
            value: "odalys"
            amount: 0
        vfxRef: "fx/pull/riptide"
        sfxRef: "sfx/pull/riptide"
        echoCostPerLevel: 10
        levels:
        - level: 1
          cooldown: 12.0
          power: 1.0
          radius: 3.5
          duration: 1.0
          energyCost: 0
          description: "A short pull. Feet slide toward you."
        - level: 2
          cooldown: 9.0
          power: 1.5
          radius: 4.5
          duration: 1.4
          energyCost: 0
          description: "The pull reaches further and holds longer."
        - level: 3
          cooldown: 6.0
          power: 2.25
          radius: 6.0
          duration: 1.8
          energyCost: 0
          description: "Full bind. The whole room leans in."
      - id: "call_ally"
        name: "Call Ally"
        line: "tide"
        description: "The Tide capstone: whoever stands with you strikes when you call - Mara, Dax, or the water itself."
        category: 0
        unlockHint: "Hold the Sanctuary."
        unlockConditions:
          - type: 17
            key: "obj_sanctuary_hold"
            value: ""
            amount: 0
        vfxRef: "fx/ally/call"
        sfxRef: "sfx/ally/call"
        echoCostPerLevel: 10
        levels:
        - level: 1
          cooldown: 12.0
          power: 1.0
          radius: 3.5
          duration: 1.0
          energyCost: 0
          description: "One answer to one call."
        - level: 2
          cooldown: 9.0
          power: 1.5
          radius: 4.5
          duration: 1.4
          energyCost: 0
          description: "The answer comes faster and hits harder."
        - level: 3
          cooldown: 6.0
          power: 2.25
          radius: 6.0
          duration: 1.8
          energyCost: 0
          description: "Full bind. You are never alone in the arena."
      - id: "tremor_stomp"
        name: "Tremor Stomp"
        line: "stone"
        description: "Bran's lesson: the ground shouts once, and everything near it forgets its footing."
        category: 0
        unlockHint: "Choose Warden Bran as your mentor on the night of the Fracture."
        unlockConditions:
          - type: 6
            key: "dec_mentor"
            value: "bran"
            amount: 0
        vfxRef: "fx/stomp/tremor"
        sfxRef: "sfx/stomp/tremor"
        echoCostPerLevel: 10
        levels:
        - level: 1
          cooldown: 12.0
          power: 1.0
          radius: 3.5
          duration: 1.0
          energyCost: 0
          description: "A short shout from the floor."
        - level: 2
          cooldown: 9.0
          power: 1.5
          radius: 4.5
          duration: 1.4
          energyCost: 0
          description: "The tremor spreads and dazes longer."
        - level: 3
          cooldown: 6.0
          power: 2.25
          radius: 6.0
          duration: 1.8
          energyCost: 0
          description: "Full bind. Nothing stands that you did not permit."
      - id: "bulwark"
        name: "Bulwark"
        line: "stone"
        description: "The Stone capstone: a parry stance; the perfect read staggers and answers."
        category: 0
        unlockHint: "Hold the Long Wall."
        unlockConditions:
          - type: 17
            key: "obj_wall_hold"
            value: ""
            amount: 0
        vfxRef: "fx/stance/bulwark"
        sfxRef: "sfx/stance/bulwark"
        echoCostPerLevel: 10
        levels:
        - level: 1
          cooldown: 12.0
          power: 1.0
          radius: 3.5
          duration: 1.0
          energyCost: 0
          description: "A moment of stone. Blows slide off."
        - level: 2
          cooldown: 9.0
          power: 1.5
          radius: 4.5
          duration: 1.4
          energyCost: 0
          description: "The stance holds longer and answers harder."
        - level: 3
          cooldown: 6.0
          power: 2.25
          radius: 6.0
          duration: 1.8
          energyCost: 0
          description: "Full bind. You are the wall."
      - id: "drain_touch"
        name: "Drain Touch"
        line: "hollow"
        description: "The Hollow line's first gift: a strike that takes what it breaks and gives it to you."
        category: 0
        unlockHint: "Let the Hollow reach 25 and drink at the dark shrine."
        unlockConditions:
          - type: 6
            key: "dec_hollow_shrine"
            value: "drink"
            amount: 0
        vfxRef: "fx/hollow/drain"
        sfxRef: "sfx/hollow/drain"
        echoCostPerLevel: 10
        levels:
        - level: 1
          cooldown: 12.0
          power: 1.0
          radius: 3.5
          duration: 1.0
          energyCost: 0
          description: "A cold hand. Some of what leaves them arrives in you."
        - level: 2
          cooldown: 9.0
          power: 1.5
          radius: 4.5
          duration: 1.4
          energyCost: 0
          description: "The drain runs deeper."
        - level: 3
          cooldown: 6.0
          power: 2.25
          radius: 6.0
          duration: 1.8
          energyCost: 0
          description: "Full bind. Nothing is lost - to you."
      - id: "hollow_throne"
        name: "Hollow Throne"
        line: "hollow"
        description: "The Hollow ultimate: everything already breaking, breaks. Dax's echo taught you this."
        category: 0
        unlockHint: "Absorb Dax's Echo after the duel."
        unlockConditions:
          - type: 6
            key: "dec_dax_duel_end"
