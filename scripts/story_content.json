  "graphs": [
    {
      "id": "g_c1_hall_first_light",
      "nodes": [
        { "id": "start", "speaker": "", "text": "", "nextId": "", "branchPrefix": "opener", "decisionId": "", "end": false, "conditions": [] },
        { "id": "opener_fresh", "speaker": "Mara", "text": "The light came through the ceiling - did you see it? Everyone's running. The Choir guards are sealing the doors.", "nextId": "opener_fresh2", "branchPrefix": "", "decisionId": "", "end": false, "conditions": [{ "type": 7, "key": "dec_c1_hall_first_light", "value": "", "amount": 0 }] },
        { "id": "opener_fresh2", "speaker": "Mara", "text": "But it looked at you, Ari. I saw it. That's not nothing.", "nextId": "opener_fresh3", "branchPrefix": "", "decisionId": "", "end": false, "conditions": [] },
        { "id": "opener_fresh3", "speaker": "Mara", "text": "We can't both stand here. You decide - I'll follow you.", "nextId": "decide", "branchPrefix": "", "decisionId": "", "end": false, "conditions": [] },
        { "id": "opener_again", "speaker": "Mara", "text": "You're still standing. Still the one the light watches. What now?", "nextId": "decide", "branchPrefix": "", "decisionId": "", "end": false, "conditions": [{ "type": 6, "key": "dec_c1_hall_first_light", "value": "", "amount": 0 }] },
        { "id": "decide", "speaker": "", "text": "", "nextId": "", "branchPrefix": "after", "decisionId": "dec_c1_hall_first_light", "end": false, "conditions": [] },
        { "id": "after_ember", "speaker": "Mara", "text": "When you moved, the columns burned red. The Choir saw. They're coming for you now, Ari.", "nextId": "end", "branchPrefix": "", "decisionId": "", "end": false, "conditions": [{ "type": 0, "key": "c1_hall_drive", "value": "ember", "amount": 0 }] },
        { "id": "after_tide", "speaker": "Mara", "text": "You pulled the twins clear - they'll make it. I've got your back. We move together from here.", "nextId": "end", "branchPrefix": "", "decisionId": "", "end": false, "conditions": [{ "type": 0, "key": "c1_hall_drive", "value": "tide", "amount": 0 }] },
        { "id": "after_stone", "speaker": "Mara", "text": "The guards walked right past us. You're scaring me a little, Ari. That's the third time.", "nextId": "end", "branchPrefix": "", "decisionId": "", "end": false, "conditions": [{ "type": 0, "key": "c1_hall_drive", "value": "stone", "amount": 0 }] },
        { "id": "after", "speaker": "Mara", "text": "...Okay. That's what we do, then.", "nextId": "end", "branchPrefix": "", "decisionId": "", "end": false, "conditions": [] },
        { "id": "end", "speaker": "", "text": "", "nextId": "", "branchPrefix": "", "decisionId": "", "end": true, "conditions": [] }
      ]
    },
    {
      "id": "g_c1_hall_shard",
      "nodes": [
        { "id": "start", "speaker": "", "text": "", "nextId": "", "branchPrefix": "shard_line", "decisionId": "", "end": false, "conditions": [] },
        { "id": "shard_line_ember", "speaker": "The Shard", "text": "It is still warm where the light fell. It tilts toward you - like a compass stuck on your name.", "nextId": "shard_offer", "branchPrefix": "", "decisionId": "", "end": false, "conditions": [{ "type": 0, "key": "c1_hall_drive", "value": "ember", "amount": 0 }, { "type": 7, "key": "dec_east_shard", "value": "", "amount": 0 }] },
        { "id": "shard_line_tide", "speaker": "The Shard", "text": "It hums low, like a held breath. You feel the twins' fear in it - and their relief.", "nextId": "shard_offer", "branchPrefix": "", "decisionId": "", "end": false, "conditions": [{ "type": 0, "key": "c1_hall_drive", "value": "tide", "amount": 0 }, { "type": 7, "key": "dec_east_shard", "value": "", "amount": 0 }] },
        { "id": "shard_line_stone", "speaker": "The Shard", "text": "It does not move. It waits, the way you waited. It watches you measure it.", "nextId": "shard_offer", "branchPrefix": "", "decisionId": "", "end": false, "conditions": [{ "type": 0, "key": "c1_hall_drive", "value": "stone", "amount": 0 }, { "type": 7, "key": "dec_east_shard", "value": "", "amount": 0 }] },
        { "id": "shard_line_left", "speaker": "The Shard", "text": "You left it before. It still hums - quieter. The choice stays yours.", "nextId": "shard_left_end", "branchPrefix": "", "decisionId": "", "end": false, "conditions": [{ "type": 6, "key": "dec_east_shard", "value": "leave", "amount": 0 }] },
        { "id": "shard_left_end", "speaker": "The Shard", "text": "The shard pulses once - acknowledgement - and dims.", "nextId": "", "branchPrefix": "", "decisionId": "", "end": true, "conditions": [] },
        { "id": "shard_line_done", "speaker": "The Shard", "text": "The shard is quiet now. It chose you once.", "nextId": "", "branchPrefix": "", "decisionId": "", "end": true, "conditions": [{ "type": 6, "key": "dec_east_shard", "value": "take", "amount": 0 }] },
        { "id": "shard_offer", "speaker": "", "text": "", "nextId": "", "branchPrefix": "shard_after", "decisionId": "dec_east_shard", "end": false, "conditions": [] },
        { "id": "shard_after_take", "speaker": "", "text": "", "nextId": "", "branchPrefix": "", "decisionId": "", "end": true, "conditions": [{ "type": 6, "key": "dec_east_shard", "value": "take", "amount": 0 }] },
        { "id": "shard_after_leave", "speaker": "", "text": "", "nextId": "", "branchPrefix": "", "decisionId": "", "end": true, "conditions": [{ "type": 6, "key": "dec_east_shard", "value": "leave", "amount": 0 }] }
      ]
    },
    {
      "id": "g_c1_hall_sera",
      "nodes": [
        { "id": "start", "speaker": "", "text": "", "nextId": "", "branchPrefix": "sera_line", "decisionId": "", "end": false, "conditions": [] },
        { "id": "sera_line_ember", "speaker": "Sera", "text": "You're the one who reached for it. The Choir has your scent now. I'd stay off the street.", "nextId": "sera_offer", "branchPrefix": "", "decisionId": "", "end": false, "conditions": [{ "type": 0, "key": "c1_hall_drive", "value": "ember", "amount": 0 }] },
        { "id": "sera_line_tide", "speaker": "Sera", "text": "You got my sisters out. I owe you. If you need an eye on that north seal - I'm your lookout.", "nextId": "sera_offer", "branchPrefix": "", "decisionId": "", "end": false, "conditions": [{ "type": 0, "key": "c1_hall_drive", "value": "tide", "amount": 0 }] },
        { "id": "sera_line_stone", "speaker": "Sera", "text": "You went still as the wall and the sweep passed right through. I don't know if that's luck - or something else.", "nextId": "sera_offer", "branchPrefix": "", "decisionId": "", "end": false, "conditions": [{ "type": 0, "key": "c1_hall_drive", "value": "stone", "amount": 0 }] },
        { "id": "sera_line_default", "speaker": "Sera", "text": "Careful. The Choir just swept the hall again. Something in there is looking at you.", "nextId": "sera_offer", "branchPrefix": "", "decisionId": "", "end": false, "conditions": [] },
        { "id": "sera_offer", "speaker": "", "text": "", "nextId": "", "branchPrefix": "sera_after", "decisionId": "dec_sera_lookout", "end": false, "conditions": [] },
        { "id": "sera_after_lookout", "speaker": "Sera", "text": "I'll be here. Nothing crosses that seal without me knowing it.", "nextId": "end", "branchPrefix": "", "decisionId": "", "end": false, "conditions": [{ "type": 6, "key": "dec_sera_lookout", "value": "lookout", "amount": 0 }] },
        { "id": "sera_after_shard_show", "speaker": "Sera", "text": "A shard from the light... The Archivist would pay to study that. Stay careful, Ari.", "nextId": "end", "branchPrefix": "", "decisionId": "", "end": false, "conditions": [{ "type": 6, "key": "dec_sera_lookout", "value": "shard_show", "amount": 0 }] },
        { "id": "sera_after_keep_low", "speaker": "Sera", "text": "...Yeah. Low is good. Low is what keeps you breathing.", "nextId": "end", "branchPrefix": "", "decisionId": "", "end": false, "conditions": [{ "type": 6, "key": "dec_sera_lookout", "value": "keep_low", "amount": 0 }] },
        { "id": "end", "speaker": "", "text": "", "nextId": "", "branchPrefix": "", "decisionId": "", "end": true, "conditions": [] }
      ]
