# =============================================
# CROSSROADS — Unity .gitignore
# =============================================

# ----- Unity generated -----
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset store tools plugin
/[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio / Rider / VS Code cache
.vs/
.gradle/
ExportedObj/
.consulo/
.idea/
.vscode/

# Autogenerated solution and project files
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app

# Crashlytics
crashlytics-build.properties

# Packed Addressables (if adopted later)
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# ----- OS -----
.DS_Store
Thumbs.db
Desktop.ini

# ----- Editors -----
*.swp
*~

# ----- Derived reference frames (regenerate: scripts/extract_reference_frames.sh) -----
/reference/frames/
/reference/chars/
/reference/contact_sheet.jpg

# ----- Sandbox/workspace artifacts -----
.arena/

# ----- Tool caches -----
.cache/

# ----- Headless C# test / compile-check artifacts (scripts/decision_system_tests) -----
/scripts/decision_system_tests/*.exe
/scripts/decision_system_tests/*.dll
/scripts/decision_system_tests/*.mdb
